        if (Low[i] < Low[i+1] && Low[i] < Low[i-1])
        {
            if (lowCount < 10) lows[lowCount++] = i;
        }
    }
    
    if (highCount < 3 || lowCount < 3) return false;
    
    // Check if lows are approximately equal
    double lowAvg = (Low[lows[0]] + Low[lows[1]] + Low[lows[2]]) / 3;
    for (int i = 0; i < MathMin(lowCount, 5); i++)
    {
        if (MathAbs(Low[lows[i]] - lowAvg) > point * 10) return false;
    }
    
    // Check if highs are descending
    for (int i = 1; i < MathMin(highCount, 5); i++)
    {
        if (High[highs[i]] >= High[highs[i-1]]) return false;
    }
    
    // Check if we're breaking the support
