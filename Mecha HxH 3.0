bool IsAscendingTriangle()
{
    // Series of higher lows with similar highs
    int bars = MathMin(Bars, MaxBarsForPattern);
    int startIndex = bars - 1;
    
    // Find at least 4 swing highs and swing lows
    int highs[10], lows[10];
    int highCount = 0, lowCount = 0;
    
    for (int i = startIndex; i > 0 && (highCount < 10 || lowCount < 10); i--)
    {
        // Simple swing high detection
        if (High[i] > High[i+1] && High[i] > High[i-1])
        {
            if (highCount < 10) highs[highCount++] = i;
        }
        
        // Simple swing low detection
        if (Low[i] < Low[i+1] && Low[i] < Low[i-1])
        {
            if (lowCount < 10) lows[lowCount++] = i;
        }
    }
    
    if (highCount < 3 || lowCount < 3) return false;
    
    // Check if highs are approximately equal
    double highAvg = (High[highs[0]] + High[highs[1]] + High[highs[2]]) / 3;
    for (int i = 0; i < MathMin(highCount, 5); i++)
    {
        if (MathAbs(High[highs[i]] - highAvg) > point * 10) return false;
    }
    
    // Check if lows are ascending
    for (int i = 1; i < MathMin(lowCount, 5); i++)
    {
        if (Low[lows[i]] <= Low[lows[i-1]]) return false;
    }
    
    // Check if we're breaking the resistance
    return Close[0] > highAvg;
}

bool IsDescendingTriangle()
{
    // Series of lower highs with similar lows
    int bars = MathMin(Bars, MaxBarsForPattern);
    int startIndex = bars - 1;
    
    // Find at least 4 swing highs and swing lows
    int highs[10], lows[10];
    int highCount = 0, lowCount = 0;
    
